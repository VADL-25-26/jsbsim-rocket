<?xml version="1.0"?>
<?xml-stylesheet type="text/xsl" href="http://jsbsim.sourceforge.net/JSBSim.xsl"?>

<fdm_config name="rocket" version="2.0" release="ALPHA"
   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
   xsi:noNamespaceSchemaLocation="http://jsbsim.sourceforge.net/JSBSim.xsd">

 <fileheader>
  <author> AeromatiC++ version 3.3.21 </author>
  <filecreationdate> 16 May 2025 </filecreationdate>
  <version>$Revision: 1.80 $</version>
  <description> Models a rocket. </description>
 </fileheader>

<!--
  File:     rocket.xml
  Input parameters:
    Output directory                   : C:\Users\bob\Downloads\
    Create a subdirectory?             : yes
    Overwrite?                         : yes
    Aircraft name                      : rocket
    Use dedicated system files?        : yes
    Select a system of measurement     : no
    Type of aircraft                   : 0
    Stall speed VS1 (clean, no flaps)  : 795.46
    Maximum takeoff weight             : 47.00
    Empty weight                       : 43.00
    Inertia Ixx                        : 0.01
    Inertia Iyy                        : 3.50
    Inertia Izz                        : 1.33
    Length                             : 9.08
    Select a wing shape                : 2
    Wing span                          : 0.50
    Wing area                          : 0.25
    Wing aspect ratio                  : 5.50
    Wing taper ratio                   : 4.00
    Wing root chord                    : 0.09
    Wing incidence                     : 0.00
    Wing dihedral                      : 0.00
    Wing sweep (quarter chord)         : 0.00
    Htail area                         : 0.04
    Htail arm                          : 4.68
    Vtail area                         : 0.03
    Vtail arm                          : 4.50
    Propulsion                         : yes
    Engine name                        : my_engine
    Number of engines                  : 1
    Engine layout                      : 2
    Engine type                        : 3
    Engine thrust                      : 444.00
    Nozzle name                        : my_nozzle
    Nozzle diameter                    : 0.25
    Landing Gear                       : no
    Flaps                              : no
    Spoilers                           : no
    Chute                              : yes
-->

 <metrics>
   <wingarea  unit="FT2"> 0.0001 </wingarea>   <!-- No wings on rocket, need small value -->
   <wingspan  unit="FT" > 0.0    </wingspan>   <!-- No wings on rocket -->
   <wing_incidence unit="DEG"> 0.00 </wing_incidence>
   <chord     unit="FT" > 0.0    </chord>      <!-- No wing chord -->
   <htailarea unit="FT2"> 0.6611 </htailarea>  <!-- 2 fins × 47.6 in² /144  -->
   <htailarm  unit="FT" > 2.633  </htailarm>   <!-- No tail arm -->
   <vtailarea unit="FT2"> 0.6611 </vtailarea>  <!-- 2 fins × 47.6 in² /144  -->
   <vtailarm  unit="FT" > 2.633  </vtailarm>   <!-- Fin arm: 90" - 58.4" = 31.6" -->
   <location name="AERORP" unit="IN">  <!-- Center of Pressure at 68.1" from diagram -->
     <x> 72.048 </x>
     <y> 0.00   </y>
     <z> 0.00   </z>
   </location>
   <location name="EYEPOINT" unit="FT"> <!-- idk what this is for-->
     <x> 1.17  </x>
     <y> -1.50 </y>
     <z> 3.75  </z>
   </location>
   <location name="VRP" unit="FT">
     <x> 0.0 </x>
     <y> 0.0 </y>
     <z> 0.0 </z>
   </location>

   <!-- use this syntax for custom parameters-->
   <property value="0.3333">metrics/acsarea</property> <!-- ACS fin area: 4 x 12in^2 = 48 in^2-->
   <property value="1.1333">metrics/acsarm</property> <!--ACS arm: 72" - 58.408" -->
 </metrics>

 <mass_balance>
   <ixx unit="SLUG*FT2"> 0.02 </ixx>
   <iyy unit="SLUG*FT2"> 1.8  </iyy>
   <izz unit="SLUG*FT2"> 1.8  </izz>
   <emptywt unit="LBS" > 41.3 </emptywt>
   <location name="CG" unit="IN">
     <x> 50.604 </x>
     <y> 0.00   </y>
     <z> 0.00   </z>
   </location>

   <pointmass name="Motor Casing">
    <description> Aerotech L1940 motor casing mass </description>
    <weight unit="LBS"> 4.48 </weight>
    <location name="POINTMASS" unit="IN">
     <x> 91   </x>
     <y> 0.00 </y>
     <z> 0.00 </z>
    </location>
   </pointmass>
 </mass_balance>

 <propulsion>
    <engine file="aerotech_l1940_engine">
        <feed>0</feed>
        <running>0</running>
        <starter>0</starter>
        <thruster file="l1940_nozzle">
            <location unit="IN">
                <x>102</x>
                <y>0.0</y>
                <z>0.0</z>
            </location>
            <orient>
                <pitch unit="DEG">0.0</pitch>
                <yaw unit="DEG">0.0</yaw>
            </orient>
        </thruster>
    </engine>

    <tank type="FUEL">
        <fuel_type>FUEL</fuel_type>
        <location unit="IN">
            <x>91</x>
            <y>0.0</y>
            <z>0.0</z>
        </location>
        <capacity unit="LBS">4.023</capacity>
        <contents unit="LBS">4.023</contents>
    </tank>
 </propulsion>

 <system file="Conventional Controls.xml"/>
 <system file="Landing Gear.xml"/>
 <!-- <system file="Rescue Chute (Ballistic Recovery System).xml"/> -->

 <flight_control name="FCS: My Aircraft">
   <channel name="Landing Gear">
    <switch name="fcs/gear-no-wow">
      <default value="1"/>
    </switch>
  </channel>
 </flight_control>

 <aerodynamics>
  <!-- (unchanged) -->
  <property value="0">aero/ACSangle</property>
  <!-- ... your full aerodynamics remain unchanged ... -->
 </aerodynamics>

 <external_reactions>
  <property value="3.14159">external_reactions/drogue_chute/drag_area</property>
  <property value="113.097">external_reactions/main_chute/drag_area</property>
  <property value="0">external_reactions/drogue_chute/drogue_open</property>
  <property value="0">external_reactions/main_chute/main_open</property>

  <force name="drogue_chute" frame="WIND">
   <function>
    <product>
     <property>aero/qbar-psf</property>
     <property>external_reactions/drogue_chute/drag_area</property>
     <table>
         <independentVar lookup="row">external_reactions/drogue_chute/drogue_open</independentVar>
         <tableData>
         0  0
         1  1.5
         </tableData>
      </table>
    </product>
   </function>
   <location unit="FT">
    <x> 0 </x>
    <y> 0 </y>
    <z> 0 </z>
   </location>
   <direction>
    <x>-1 </x>
    <y> 0 </y>
    <z> 0 </z>
   </direction>
  </force>

  <force name="main_chute" frame="WIND">
   <function>
    <product>
     <property>aero/qbar-psf</property>
     <property>external_reactions/main_chute/drag_area</property>
     <table>
         <independentVar lookup="row">external_reactions/main_chute/main_open</independentVar>
         <tableData>
         0  0
         1  2.2
         </tableData>
      </table>
    </product>
   </function>
   <location unit="FT">
    <x> 0 </x>
    <y> 0 </y>
    <z> 0 </z>
   </location>
   <direction>
    <x>-1 </x>
    <y> 0 </y>
    <z> 0 </z>
   </direction>
  </force>

 </external_reactions>

 <ground_reactions>
    <contact type="BOGEY" name="LANDING_CONTACT">
        <location unit="IN">
            <x>101</x>
            <y>0.0</y>
            <z>0.25</z>
        </location>
        <static_friction>0.8</static_friction>
        <dynamic_friction>0.7</dynamic_friction>
        <rolling_friction>0.01</rolling_friction>
        <spring_coeff unit="LBS/FT">0.01</spring_coeff>
        <damping_coeff unit="LBS/FT/SEC">0.01</damping_coeff>
        <max_steer unit="DEG">0.0</max_steer>
        <brake_group>NONE</brake_group>
    </contact>
 </ground_reactions>

</fdm_config>