<?xml version="1.0"?>
<?xml-stylesheet type="text/xsl" href="http://jsbsim.sourceforge.net/JSBSim.xsl"?>

<fdm_config name="rocket" version="2.0" release="ALPHA"
   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
   xsi:noNamespaceSchemaLocation="http://jsbsim.sourceforge.net/JSBSim.xsd">

 <fileheader>
  <author> AeromatiC++ version 3.3.21 </author>
  <filecreationdate> 16 May 2025 </filecreationdate>
  <version>$Revision: 1.80 $</version>
  <description> Models a rocket. </description>
 </fileheader>

 <metrics>
   <wingarea  unit="FT2"> 0.0001    </wingarea>   <!-- No wings on rocket, need small value -->
   <wingspan  unit="FT" > 0.0      </wingspan>   <!-- No wings on rocket -->
   <wing_incidence unit="DEG"> 0.00 </wing_incidence>
   <chord     unit="FT" > 0.0      </chord>      <!-- No wing chord -->
   <htailarea unit="FT2"> 0.6611   </htailarea>  <!-- 2 fins × 47.6 in² /144  -->
   <htailarm  unit="FT" > 2.633     </htailarm>   <!-- No tail arm -->
   <vtailarea  unit="FT2">0.6611     </vtailarea>  <!-- 2 fins × 47.6 in² /144  -->
   <vtailarm  unit="FT" > 2.633   </vtailarm>   <!-- Fin arm: 90" - 58.4" = 31.6" -->
   <location name="AERORP" unit="IN">  <!-- Center of Pressure at 68.1" from diagram -->
     <x> 72.477     </x>  
     <y> 0.00     </y>
     <z> 0.00     </z>
   </location>
   <location name="EYEPOINT" unit="FT"> <!-- idk what this is for-->
     <x> 1.17     </x>
     <y> -1.50    </y>
     <z> 3.75     </z>
   </location>
   <location name="VRP" unit="FT">
     <x>     0.0 </x>
     <y>     0.0 </y>
     <z>     0.0 </z>
   </location>

   <!-- use this syntax for custom parameters-->
   <property value="0.3333">metrics/acsarea</property> <!-- ACS fin area: 4 x 12in^2 = 48 in^2-->
   <property value="1.1333">metrics/acsarm</property> <!--ACS arm: 72" - 58.408" -->
 </metrics>

 <mass_balance>
   <ixx unit="SLUG*FT2">  0.02    </ixx>  <!-- Roll inertia for 6" diameter rocket (much smaller) -->
   <iyy unit="SLUG*FT2">  1.8     </iyy>   <!-- Pitch/Yaw inertia for 109" rocket (much smaller) -->
   <izz unit="SLUG*FT2">  1.8     </izz>   <!-- Pitch/Yaw inertia for 109" rocket (much smaller) -->
   <emptywt unit="LBS" >  41.3 </emptywt>  <!-- Restored to original spec (was 35.0) -->
   <location name="CG" unit="IN">  <!-- No motor CG" -->
     <x> 50.6    </x>
     <y> 0.00     </y>
     <z> 0.00     </z>
   </location>

   <pointmass name="Motor Casing">
    <description> Aerotech K1800 motor casing mass </description>
    <weight unit="LBS"> 3.66 </weight> 
    <location name="POINTMASS" unit="IN">  <!-- Motor location at rear -->
     <x> 96    </x>  <!-- Around 89" from nose -->
     <y> 0.00     </y>
     <z> 0.00    </z>
   </location>
   </pointmass>
 </mass_balance>

 <propulsion>
    <engine file="aerotech_k1800_engine">
        <feed>0</feed>
        <running>0</running>
        <starter>0</starter>
        <thruster file="l1940_nozzle">
            <location unit="IN">  <!-- Motor at rear of rocket -->
                <x>103</x>  
                <y>0.0</y>
                <z>0.0</z>
            </location>
            <orient>
                <pitch unit="DEG">0.0</pitch>  <!-- Aligned with body X-axis for forward thrust -->
                <yaw unit="DEG">0.0</yaw>
            </orient>
        </thruster>
    </engine>

    <tank type="FUEL">
        <fuel_type>FUEL</fuel_type>
        <location unit="IN">  <!-- Motor fuel location -->
            <x>96</x>  <!-- Motor center -->
            <y>0.0</y>
            <z>0.0</z>
        </location>
        <capacity unit="LBS">2.45</capacity>  <!-- K1800 propellant mass -->
        <contents unit="LBS">2.45</contents>
    </tank>
 </propulsion>

 <system file="Conventional Controls.xml"/>
 <system file="Landing Gear.xml"/>
 <!-- <system file="Rescue Chute (Ballistic Recovery System).xml"/> -->

 <flight_control name="FCS: My Aircraft">
   <channel name="Landing Gear">
    <switch name="fcs/gear-no-wow">
      <default value="1"/>
    </switch>
  </channel>
 </flight_control>

 <aerodynamics>
  <property value="0">aero/ACSangle</property>  <!-- ACS fin deflection angle in rad -->
  <!-- ... unchanged aerodynamics omitted for brevity in this message ... -->
 </aerodynamics>

 <external_reactions>
  <property value="3.14159">external_reactions/drogue_chute/drag_area</property>
  <property value="113.097">external_reactions/main_chute/drag_area</property>
  <property value="0">external_reactions/drogue_chute/drogue_open</property>
  <property value="0">external_reactions/main_chute/main_open</property>

  <!-- ------------------------------------------------------------------ -->
  <!-- LAUNCH RAIL FRICTION (controlled from C++)                           -->
  <!-- C++ sets:                                                            -->
  <!--   external_reactions/rail_friction/on        = 0/1                    -->
  <!--   external_reactions/rail_friction/force_lbs = friction magnitude lbf -->
  <!-- Force is applied along BODY -X (opposes thrust direction +X).         -->
  <!-- ------------------------------------------------------------------ -->
  <property value="0">external_reactions/rail_friction/on</property>
  <property value="0">external_reactions/rail_friction/force_lbs</property>

  <force name="rail_friction" frame="BODY">
   <function>
    <product>
     <property>external_reactions/rail_friction/force_lbs</property>
     <table>
      <independentVar lookup="row">external_reactions/rail_friction/on</independentVar>
      <tableData>
       0  0
       1  1
      </tableData>
     </table>
    </product>
   </function>

   <!-- Put at CG so it does not create any artificial pitching moment -->
   <location unit="IN">
    <x> 50.6 </x>
    <y> 0.0 </y>
    <z> 0.0 </z>
   </location>

   <direction>
    <x>-1</x>
    <y> 0</y>
    <z> 0</z>
   </direction>
  </force>

  <force name="drogue_chute" frame="WIND">
   <function>
    <product>
     <property>aero/qbar-psf</property>
     <property>external_reactions/drogue_chute/drag_area</property>
     <table>
         <independentVar lookup="row">external_reactions/drogue_chute/drogue_open</independentVar>
         <tableData>
         0  0
         1  1.5
         </tableData>
      </table>
    </product>
   </function>
   <location unit="FT">  <!-- Nose of rocket for drogue -->
    <x> 0 </x>
    <y> 0 </y>
    <z> 0 </z>
   </location>
   <direction>
    <x>-1 </x>  <!-- Opposes forward motion -->
    <y> 0 </y>
    <z> 0 </z>
   </direction>
  </force>

  <force name="main_chute" frame="WIND">
   <function>
    <product>
     <property>aero/qbar-psf</property>
     <property>external_reactions/main_chute/drag_area</property>
     <table>
         <independentVar lookup="row">external_reactions/main_chute/main_open</independentVar>
         <tableData>
         0  0
         1  2.2
         </tableData>
      </table>
    </product>
   </function>
   <location unit="FT">  <!-- Nose of rocket for main chute -->
    <x> 0 </x>
    <y> 0 </y>
    <z> 0 </z>
   </location>
   <direction>
    <x>-1 </x>  <!-- Opposes forward motion -->
    <y> 0 </y>
    <z> 0 </y>
   </direction>
  </force>

 </external_reactions>

 <ground_reactions>
    <contact type="BOGEY" name="LANDING_CONTACT">
        <location unit="IN">  <!-- Contact point at rocket nozzle (bottom end) -->
            <x>104</x>  <!-- At nozzle end (103" from nose) -->
            <y>0.0</y>
            <z>0.25</z>   <!-- At bottom surface of rocket (3" radius = 0.25 ft down from centerline) -->
        </location>
        <static_friction>0.8</static_friction>
        <dynamic_friction>0.7</dynamic_friction>
        <rolling_friction>0.01</rolling_friction>
        <spring_coeff unit="LBS/FT">0.01</spring_coeff>  <!-- Very weak spring to minimize false triggers -->
        <damping_coeff unit="LBS/FT/SEC">0.01</damping_coeff>  <!-- Very weak damping -->
        <max_steer unit="DEG">0.0</max_steer>
        <brake_group>NONE</brake_group>
    </contact>
 </ground_reactions>

</fdm_config>